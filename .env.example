# AI-Trader Configuration (copy to .env and fill in)
# The browser system works out of the box with synthetic data —
# only set keys for the features you want.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Browser / server ---
HOST=0.0.0.0
PORT=8000

# --- Live market data (optional; enables the "twelvedata" source) ---
AITRADER_TWELVEDATA_API_KEY=

# --- Legacy prototype keys (src/ only; not needed for the browser system) ---
EXCHANGE_API_KEY=
NEWS_API_KEY=
VIX_API_KEY=

# --- Engine ---
DATABASE_URL=sqlite:///data/trader.db
AITRADER_DATA_DIR=data
AITRADER_EXECUTION_MODE=SIGNAL_ONLY

# --- Risk limits ---
MAX_RISK_PER_TRADE_PCT=2.0
MAX_PORTFOLIO_RISK_PCT=20.0

# --- Analysis defaults ---
DEFAULT_PAIR=EUR/USD
ANALYSIS_INTERVAL_MINUTES=5
