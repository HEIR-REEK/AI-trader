# AI-Trader Production Configuration
# Set real API keys in environment variables before deployment.
# No simulated fallbacks — missing keys will cause explicit failures.

ENVIRONMENT=production
LOG_LEVEL=INFO

# Real-Time Data APIs
EXCHANGE_API_KEY=${EXCHANGE_API_KEY}
NEWS_API_KEY=${NEWS_API_KEY}
VIX_API_KEY=${VIX_API_KEY}

# Database
DATABASE_URL=sqlite:///data/trader.db

# Server
HOST=0.0.0.0
PORT=8000

# Risk Limits
MAX_RISK_PER_TRADE_PCT=2.0
MAX_PORTFOLIO_RISK_PCT=20.0

# Analysis
DEFAULT_PAIR=EUR/USD
ANALYSIS_INTERVAL_MINUTES=5
